{
  "name": "ioricore-tooling",
  "private": true,
  "description": "Solo Prettier (Java/YAML). No runtime del plugin.",
  "scripts": {
    "format": "prettier --write \"velocity/src/**/*.{java,yml,yaml}\" \"bungee/src/**/*.{java,yml,yaml}\" \"bukkit/src/**/*.{java,yml,yaml}\" \"common/src/**/*.{java,yml,yaml}\" \"api/src/**/*.{java,yml,yaml}\"",
    "format:check": "prettier --check \"velocity/src/**/*.{java,yml,yaml}\" \"bungee/src/**/*.{java,yml,yaml}\" \"bukkit/src/**/*.{java,yml,yaml}\" \"common/src/**/*.{java,yml,yaml}\" \"api/src/**/*.{java,yml,yaml}\""
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "prettier-plugin-java": "^2.6.7"
  }
}
